    <script>
        function toggleDetails(id) {
            const el = document.getElementById(id);
            const isVisible = el.style.display === 'block';
            document.querySelectorAll('.course-detail').forEach(d => d.style.display = 'none');
            el.style.display = isVisible ? 'none' : 'block';
        }
    </script>

    <script>
        // Evita enviar el formulario sin la aceptación obligatoria.
        document.getElementById('leadForm')?.addEventListener('submit', function (event) {
            const consentimiento = this.querySelector('[name="aceptacion_datos"]');
            if (!consentimiento.checked) {
                event.preventDefault();
                alert('Debes aceptar la Política de Tratamiento de Datos Personales para enviar tu solicitud.');
                consentimiento.focus();
            }
        });
